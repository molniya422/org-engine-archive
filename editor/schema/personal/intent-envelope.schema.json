{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal/intent-envelope.schema.json",
  "title": "IntentEnvelope",
  "description": "The constrained output of intent understanding. Confidence only routes clarification, it never upgrades statements to facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "conversation_id", "task_type", "goal", "missing_fields", "confidence", "created_at", "schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^intent_[A-Za-z0-9_-]+$" },
    "conversation_id": { "type": "string", "pattern": "^conv_[A-Za-z0-9_-]+$" },
    "task_type": { "enum": ["file_organize", "weather_reminder", "travel_plan", "calendar", "draft", "unknown"] },
    "goal": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place": { "type": "string" },
        "time": { "type": "string" },
        "people": { "type": "number", "minimum": 0 },
        "budget": { "type": ["number", "null"], "minimum": 0 },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "unacceptable": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timezone": { "type": "string", "minLength": 1 },
    "missing_fields": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
