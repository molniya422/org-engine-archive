{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal/user-fact.schema.json",
  "title": "UserFact",
  "description": "A fact about the user. Every fact must trace to at least one evidence source. User statements stay kind=user_statement in Evidence and never auto-upgrade to external fact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "value", "source_refs", "confidence", "valid_from", "sensitivity", "status", "created_at", "updated_at", "schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^fact_[A-Za-z0-9_-]+$" },
    "kind": { "enum": ["identity", "schedule", "contact", "health", "finance", "work", "preference", "other"] },
    "value": { "type": ["object", "string", "number", "boolean"] },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^evidence_[A-Za-z0-9_-]+$" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "sensitivity": { "enum": ["normal", "sensitive", "high"] },
    "status": { "enum": ["active", "expired", "revoked"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
